{
  "name": "phonebook-pipeline",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "backend",
    "frontend",
    "e2e-tests"
  ],
  "scripts": {
    "test": "npm run test:backend && npm run test:e2e",
